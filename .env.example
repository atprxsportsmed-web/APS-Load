# Clerk — publishable key for the frontend (pk_test_… / pk_live_…)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Origin of the API server this web build talks to, including protocol.
# Leave unset to make the app run fully offline (local storage only).
EXPO_PUBLIC_API_URL=https://your-api-host.example.com

# Optional: Clerk proxy URL, if you front Clerk with your own domain.
# EXPO_PUBLIC_CLERK_PROXY_URL=
